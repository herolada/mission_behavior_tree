<?xml version="1.0"?>
<!--
  Patrol a route; when the battery runs low, go home and stay there until it is
  charged again, then resume the patrol. All of it is the BatteryPatrol subtree
  (subtrees/battery_patrol.xml), shared with patrol_home_stop.xml.

  Blackboard entries (from the blackboard: section of config/battery_patrol.yaml):
    battery_topic, battery_low, battery_charged, battery_is_voltage,
    home_route, home_route_goal_point, home_wgs, patrol_route, patrol_wgs,
    operator_request_service, commander_state_topic,
    accept_timeout, stuck_timeout,
    recharging (bool latch, initially false; kept across tree restarts).

  A failed branch fails the whole tree; mission_bt_node restarts it after
  retry_delay.
-->
<root BTCPP_format="4" main_tree_to_execute="BatteryPatrolMission">

  <!-- Relative to this file. -->
  <include path="subtrees/needs_charging.xml"/>
  <include path="subtrees/go_home.xml"/>
  <include path="subtrees/battery_patrol.xml"/>

  <BehaviorTree ID="BatteryPatrolMission">
    <SubTree ID="BatteryPatrol" _autoremap="true"/>
  </BehaviorTree>

</root>
